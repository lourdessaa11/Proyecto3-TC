# Maquina de Turing que duplica una cadena
# Convierte "abc" en "abcabc"
mt:
  states: [q0, q1, q2, q3, q4, q5, q6, qf]
  input_alphabet: [a, b]
  tape_alphabet: [a, b, B, X, Y, M]
  initial_state: q0
  accept_states: [qf]
  transitions:
    # Estado q0: marcar inicio y buscar final
    - state: q0
      read: [a]
      write: [a]
      move: R
      next: q0
    - state: q0
      read: [b]
      write: [b]
      move: R
      next: q0
    - state: q0
      read: [B]
      write: [M]
      move: L
      next: q1
    # Estado q1: copiar 'a'
    - state: q1
      read: [a]
      write: [X]
      move: R
      next: q2
    # Estado q1: copiar 'b'
    - state: q1
      read: [b]
      write: [Y]
      move: R
      next: q4
    # Estado q1: terminar
    - state: q1
      read: [X]
      write: [a]
      move: R
      next: q6
    - state: q1
      read: [Y]
      write: [b]
      move: R
      next: q6
    # Estado q2: ir al final y escribir 'a'
    - state: q2
      read: [a]
      write: [a]
      move: R
      next: q2
    - state: q2
      read: [b]
      write: [b]
      move: R
      next: q2
    - state: q2
      read: [X]
      write: [X]
      move: R
      next: q2
    - state: q2
      read: [Y]
      write: [Y]
      move: R
      next: q2
    - state: q2
      read: [M]
      write: [M]
      move: R
      next: q3
    - state: q3
      read: [a]
      write: [a]
      move: R
      next: q3
    - state: q3
      read: [b]
      write: [b]
      move: R
      next: q3
    - state: q3
      read: [B]
      write: [a]
      move: L
      next: q5
    # Estado q4: ir al final y escribir 'b'
    - state: q4
      read: [a]
      write: [a]
      move: R
      next: q4
    - state: q4
      read: [b]
      write: [b]
      move: R
      next: q4
    - state: q4
      read: [X]
      write: [X]
      move: R
      next: q4
    - state: q4
      read: [Y]
      write: [Y]
      move: R
      next: q4
    - state: q4
      read: [M]
      write: [M]
      move: R
      next: q3
    - state: q3
      read: [B]
      write: [b]
      move: L
      next: q5
    # Estado q5: regresar
    - state: q5
      read: [a]
      write: [a]
      move: L
      next: q5
    - state: q5
      read: [b]
      write: [b]
      move: L
      next: q5
    - state: q5
      read: [M]
      write: [M]
      move: L
      next: q5
    - state: q5
      read: [X]
      write: [X]
      move: L
      next: q5
    - state: q5
      read: [Y]
      write: [Y]
      move: L
      next: q5
    - state: q5
      read: [B]
      write: [B]
      move: R
      next: q1
    # Estado q6: limpiar y terminar
    - state: q6
      read: [a]
      write: [a]
      move: R
      next: q6
    - state: q6
      read: [b]
      write: [b]
      move: R
      next: q6
    - state: q6
      read: [X]
      write: [a]
      move: R
      next: q6
    - state: q6
      read: [Y]
      write: [b]
      move: R
      next: q6
    - state: q6
      read: [M]
      write: [B]
      move: R
      next: qf

inputs:
  - "aabba"      # ACEPTADA → "aabbaaabba"
  - "ababa"      # ACEPTADA → "ababaababa"
  - "bbbbb"      # ACEPTADA → "bbbbbbb bbb"
  - "aaaaa"      # ACEPTADA → "aaaaaaaaaa"